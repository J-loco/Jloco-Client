{
  "name": "jloco-launcher",
  "productName": "JLoco Launcher",
  "version": "1.0.0",
  "description": "Patcher and launcher for the JLoco Dofus 1.39 client",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "manifest": "node tools/build-manifest.js"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.jloco.launcher",
    "productName": "JLoco Launcher",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "launcher.config.json", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "JLoco-Launcher-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "JLoco"
    }
  }
}
